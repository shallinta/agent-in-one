+  readonly sessionId: SessionId
+  /** Open turn containing this request. */
+  readonly turn: number
+  /** Open step containing this request. */
+  readonly step: number
+  /** One-based provider attempt within this step; a new step starts again at one. */
+  readonly attempt: number
+  /** Effective provider/model call configuration recorded by the request header. */
