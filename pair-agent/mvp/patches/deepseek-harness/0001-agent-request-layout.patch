+import { describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry, { type Agent } from '@deepseek-ai/dsh-agent'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import * as AgentLoopInvariant from '@deepseek-ai/dsh-agent-loop/invariant'
+import InvariantRegistry from '@deepseek-ai/dsh-invariants'
+import LlmRuntime, {
+  CallId,
+  createAssistantMessage,
+  createToolResultMessage,
+  createUserMessage,
+  LlmError,
+  type Message,
+} from '@deepseek-ai/dsh-llm'
+import SessionStore, { SessionId } from '@deepseek-ai/dsh-session'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime, { defineContentToolFixture } from '@deepseek-ai/dsh-tools'
+import { MockAdapter, textResponse, toolCallResponse } from './mock-adapter.ts'
+import { finalizeRequestLayout } from '../src/request-layout.ts'
+
+async function harness(adapter: MockAdapter, invariants = false): Promise<Context> {
+  const ctx = new Context()
+  await ctx.plugin(LlmRuntime)
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SystemPrompt, { persona: 'stable layout system' })
+  await ctx.plugin(ToolRuntime)
+  await ctx.plugin(AgentRegistry)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  if (invariants) {
+    await ctx.plugin(InvariantRegistry)
+    await ctx.plugin(AgentLoopInvariant)
+  }
+  ctx.llm.registerAdapter(['mock'], adapter)
+  return ctx
+}
+
+function message(text: string) {
+  return createUserMessage({
+    content: [{ type: 'text', text }],
+    source: { kind: 'user' },
+  })
+}
+
+function send(agent: Agent, text: string): void {
+  agent.followup(message(text))
+}
+
+function registerEcho(ctx: Context): void {
+  ctx.tools.register(defineContentToolFixture({
+    name: 'echo',
+    description: 'echo back',
+    parameters: { text: { type: 'string' } },
+    async execute(args) {
+      return [{ type: 'text', text: `echo: ${String(args.text)}` }]
+    },
+  }))
+}
+
+describe('agent/request-layout', () => {
+  it('preserves the baseline request when no listener is registered', async () => {
+    const adapter = new MockAdapter([textResponse('done')])
+    const ctx = await harness(adapter)
+    const agent = ctx.agentLoop.create(SessionId('layout-identity'), {
+      provider: 'mock',
+      model: 'mock',
+    })
+    const input = message('identity')
+
+    agent.followup(input)
+    await agent.whenIdle()
+
+    expect(adapter.requests).toHaveLength(1)
+    expect(adapter.requests[0]).toMatchObject({
+      provider: 'mock',
+      model: 'mock',
+      messages: [input],
+      sessionId: agent.session.id,
+    })
+    expect(adapter.requests[0]?.system).toContain('stable layout system')
+    expect(adapter.requests[0]?.tools).toBeUndefined()
+  })
+
+  it('reuses the frozen source array for an identity listener', async () => {
+    const adapter = new MockAdapter([textResponse('done')])
+    const ctx = await harness(adapter, true)
+    const agent = ctx.agentLoop.create(SessionId('layout-identity-reference'), {
+      provider: 'mock',
+      model: 'mock',
+    })
+    let source: readonly Message[] | undefined
+    ctx.on('agent/request-layout', async ({ messages }, next) => {
+      source = messages
+      return next()
+    })
+
+    send(agent, 'identity-reference')
+    await agent.whenIdle()
+
