diff --git a/packages/core/agent-loop/src/request-layout.ts b/packages/core/agent-loop/src/request-layout.ts
new file mode 100644
index 0000000000000000000000000000000000000000..be01a32709cd8649f30da79e58d09fb787d0ff81
--- /dev/null
+++ b/packages/core/agent-loop/src/request-layout.ts
@@ -0,0 +1,184 @@
+/** Request-layout validation and process-local reconstruction provenance. */
+
+import {
+  assertContentBlocks,
+  deepFreeze,
+  type AssistantMessage,
+  type GenerateOptions,
+  type Message,
+  type ToolResultMessage,
+  type UserMessage,
+} from '@deepseek-ai/dsh-llm'
+import { adoptSessionEvent } from '@deepseek-ai/dsh-session'
+
+/** Source derivation retained outside the durable log for one live request. */
+export interface RequestLayoutProvenance {
+  /** Frozen Session-derived messages supplied to the layout waterfall. */
+  readonly sourceBoundaryMessages: readonly Message[]
+  /** Whether the waterfall returned a different messages array. */
+  readonly layoutApplied: boolean
+}
+
+const requestLayoutProvenance = new WeakMap<GenerateOptions, RequestLayoutProvenance>()
+
+/**
+ * Record package-private source derivation for one loop-built request.
+ *
+ * @param request - Final frozen provider request.
+ * @param provenance - Frozen source-boundary metadata for the request.
+ */
+export function recordRequestLayoutProvenance(
+  request: GenerateOptions,
+  provenance: RequestLayoutProvenance,
+): void {
+  requestLayoutProvenance.set(request, Object.freeze(provenance))
+}
+
+/**
+ * Read package-private source derivation for invariant checking.
+ *
+ * @param request - Final frozen provider request.
+ * @returns The request provenance when the loop constructed the request.
+ */
+export function getRequestLayoutProvenance(
+  request: GenerateOptions,
+): RequestLayoutProvenance | undefined {
+  return requestLayoutProvenance.get(request)
+}
+
+/** Narrow an unknown value to a non-null object record. */
+function objectRecord(value: unknown): Record<string, unknown> | undefined {
+  return typeof value === 'object' && value !== null
+    ? value as Record<string, unknown>
+    : undefined
+}
+
+/** Reuse Session's message validator without publishing a synthetic event. */
+function validateMessage(message: unknown, index: number): asserts message is Message {
+  const record = objectRecord(message)
+  if (record === undefined) {
+    throw new Error(`agent/request-layout message at index ${index} is not an object`)
+  }
+  const base = { seq: index, time: 0, surfaceOp: 'append' as const }
+  if (record['role'] === 'assistant') {
+    adoptSessionEvent({
+      ...base,
+      type: 'assistant/message',
+      data: { turn: 1, step: 1, message: message as AssistantMessage },
+    })
+    return
+  }
+  const source = objectRecord(record['source'])
+  const content = record['content']
+  const hasToolResult = Array.isArray(content)
+    && content.some(block => objectRecord(block)?.['type'] === 'tool-result')
+  if (source?.['kind'] === 'tool' || hasToolResult) {
+    adoptSessionEvent({
+      ...base,
+      type: 'tool/result',
+      data: { turn: 1, step: 1, message: message as ToolResultMessage },
+    })
+    return
+  }
+  if (record['role'] === 'user') {
+    adoptSessionEvent({
+      ...base,
+      type: 'user/message',
+      data: message as UserMessage,
+    })
+    return
+  }
+  if (record['role'] !== 'system') {
+    throw new Error(`agent/request-layout message at index ${index} has an invalid role`)
+  }
+  if (typeof record['id'] !== 'string' || record['id'].length === 0) {
+    throw new Error(`agent/request-layout message at index ${index} lacks an identified message`)
+  }
+  if (!Array.isArray(content)
+    || source === undefined
+    || typeof source['kind'] !== 'string'
+    || source['kind'].length === 0) {
+    throw new Error(`agent/request-layout system message at index ${index} has invalid content or source`)
+  }
+  assertContentBlocks(content, `agent/request-layout system message at index ${index} content`)
+  deepFreeze(message)
+}
+
+/** Validate top-level tool calls and results in projected message order. */
+function validateToolProtocol(messages: readonly Message[]): void {
+  const pending = new Set<string>()
+  for (const [messageIndex, message] of messages.entries()) {
+    const calls: Record<string, unknown>[] = []
+    const results: Record<string, unknown>[] = []
+    for (const value of message.content as unknown[]) {
+      const block = objectRecord(value)
+      if (block?.['type'] === 'tool-call') calls.push(block)
+      if (block?.['type'] === 'tool-result') results.push(block)
+    }
+    if (pending.size > 0 && (calls.length > 0 || results.length === 0)) {
+      throw new Error('agent/request-layout tool-call messages must be followed immediately by tool-result messages')
+    }
+    if (calls.length > 0) {
+      if (message.role !== 'assistant' || message.source.kind !== 'model') {
+        throw new Error(`agent/request-layout tool-call at message index ${messageIndex} must belong to an assistant model message`)
+      }
+      for (const block of calls) {
+        const id = block['id']
+        if (typeof id !== 'string' || id.length === 0
+          || typeof block['name'] !== 'string' || block['name'].length === 0
+          || typeof block['arguments'] !== 'string') {
+          throw new Error(`agent/request-layout tool-call at message index ${messageIndex} is invalid`)
+        }
+        if (pending.has(id)) {
+          throw new Error(`agent/request-layout tool-call "${id}" occurs more than once`)
+        }
+        pending.add(id)
+      }
+    }
+    if (results.length === 0) continue
+    if (message.role !== 'user' || message.source.kind !== 'tool') {
+      throw new Error(`agent/request-layout tool-result at message index ${messageIndex} must belong to a user tool message`)
+    }
+    for (const block of results) {
+      const toolCallId = block['toolCallId']
+      if (typeof toolCallId !== 'string' || !pending.delete(toolCallId)) {
+        throw new Error(`agent/request-layout tool-result "${String(toolCallId)}" has no matching tool-call`)
+      }
+    }
+  }
+  const [missing] = pending
+  if (missing !== undefined) {
+    throw new Error(`agent/request-layout tool-call "${missing}" has no matching tool-result`)
+  }
+}
+
+/**
+ * Select identity or create and validate one detached transformed snapshot.
+ *
+ * @param result - Untrusted waterfall result returned by request-layout listeners.
+ * @param sourceBoundaryMessages - Frozen Session-derived identity result.
+ * @returns Frozen final messages and whether a transformed array was supplied.
+ */
+export function finalizeRequestLayout(
+  result: unknown,
+  sourceBoundaryMessages: Message[],
+): { messages: Message[]; layoutApplied: boolean } {
+  const record = objectRecord(result)
+  if (record === undefined) {
+    throw new Error('agent/request-layout must return an object with a messages array')
+  }
+  const candidate = record['messages']
+  if (candidate === sourceBoundaryMessages) {
+    return { messages: sourceBoundaryMessages, layoutApplied: false }
+  }
+  if (!Array.isArray(candidate)) {
+    throw new Error('agent/request-layout must return an object with a messages array')
+  }
+  const snapshot: unknown[] = structuredClone(candidate)
+  snapshot.forEach((message, index) => {
+    validateMessage(message, index)
+  })
+  const messages = snapshot as Message[]
+  validateToolProtocol(messages)
+  return { messages: deepFreeze(messages), layoutApplied: true }
+}
