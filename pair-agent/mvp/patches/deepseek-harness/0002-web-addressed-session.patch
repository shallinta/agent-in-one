diff --git a/packages/client/runtime/src/client/web-session-boot.ts b/packages/client/runtime/src/client/web-session-boot.ts
new file mode 100644
index 0000000000..670848eaf4
--- /dev/null
+++ b/packages/client/runtime/src/client/web-session-boot.ts
@@ -0,0 +1,59 @@
+/** Generic URL-selected Web Session boot and embedded presentation options. */
+import type { SessionId } from '@deepseek-ai/dsh-api-remotes/client'
+
+/** A root Session whose existence must be proven by the Host list before UI activation. */
+export interface AddressedSessionBoot {
+  readonly rootSessionId: SessionId
+}
+
+/** Browser boot projection shared by the Session runtime and presentation shell. */
+export interface WebSessionBoot {
+  readonly embedded: boolean
+  readonly addressed?: AddressedSessionBoot
+}
+
+const RESERVED = ['embedded', 'session', 'expectedSession'] as const
+
+function single(params: URLSearchParams, name: typeof RESERVED[number]): string | undefined {
+  const values = params.getAll(name)
+  if (values.length > 1) throw new Error(`web session boot: duplicate ${name} parameter`)
+  return values[0]
+}
+
+function sessionId(value: string | undefined, name: string): SessionId | undefined {
+  if (value === undefined) return undefined
+  if (value.length === 0) throw new Error(`web session boot: ${name} must not be empty`)
+  if (value.length > 1024) throw new Error(`web session boot: ${name} is too long`)
+  if (/\p{Cc}/u.test(value)) throw new Error(`web session boot: ${name} must not contain control characters`)
+  return value as SessionId
+}
+
+/**
+ * Parse the generic Web boot query before SessionRuntime construction.
+ * `expectedSession` only catches accidental carrier mismatches; Host list
+ * membership and catalog lineage remain the navigation authorities.
+ * @param search - location search string, including or excluding the leading question mark.
+ * @returns validated boot options for the Session runtime and Web presentation.
+ */
+export function parseWebSessionBoot(search: string): WebSessionBoot {
+  const params = new URLSearchParams(search)
+  const embeddedValue = single(params, 'embedded')
+  if (embeddedValue !== undefined && embeddedValue !== '1') {
+    throw new Error('web session boot: embedded must be exactly "1"')
+  }
+  const rootSessionId = sessionId(single(params, 'session'), 'session')
+  const expectedSessionId = sessionId(single(params, 'expectedSession'), 'expectedSession')
+  if (expectedSessionId !== undefined && rootSessionId === undefined) {
+    throw new Error('web session boot: expectedSession requires session')
+  }
+  if (expectedSessionId !== undefined && expectedSessionId !== rootSessionId) {
+    throw new Error('web session boot: session does not match expectedSession')
+  }
+  if (embeddedValue === '1' && rootSessionId === undefined) {
+    throw new Error('web session boot: embedded presentation requires session')
+  }
+  return {
+    embedded: embeddedValue === '1',
+    ...(rootSessionId === undefined ? {} : { addressed: { rootSessionId } }),
+  }
+}
