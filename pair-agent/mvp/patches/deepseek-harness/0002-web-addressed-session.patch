+// Generic addressed/embedded Web seam: two same-origin browsing contexts
+// share browser storage but boot independent Session runtimes, validate their
+// Host-listed roots before mounting the conversation, and never converge on
+// the global persisted-current key.
+import type { Browser, BrowserContext, Page } from 'playwright'
+import { chromium } from 'playwright'
+import { afterAll, beforeAll, describe, expect, it } from 'vitest'
+import { fileURLToPath } from 'node:url'
+import {
+  SESSION_FORMAT_VERSION, SessionId as sessionId, type SessionEvent,
+} from '@deepseek-ai/dsh-session'
+import { snapshotSubagentDescriptor } from '@deepseek-ai/dsh-subagent'
+import {
+  launchWebScaffold, seedBlankSession, watchConsole, type WebScaffold,
+} from './scaffold.ts'
+
+const FIRST_ROOT = 'addressed-first-root'
+const SECOND_ROOT = 'addressed-second-root'
+const SECOND_CHILD = 'addressed-second-child'
+const SECOND_CHILD_LABEL = 'addressed child'
+const BLANK_ROOT = 'addressed-blank-root'
+const BLANK_PROMPT = 'Use the bash tool to run exactly: echo WEB_E2E_OK. Then reply with the single word DONE and stop.'
+const BLANK_FIXTURE = fileURLToPath(new URL('./snapshots/fresh-round-trip/session.jsonl', import.meta.url))
+
+function addressedUrl(baseUrl: string, session: string, pane: string): string {
+  const query = new URLSearchParams({
+    embedded: '1',
+    session,
+    expectedSession: session,
+    pane,
+  })
+  return `${baseUrl}?${query.toString()}`
+}
+
+function addressedGlobalUrl(baseUrl: string, session: string): string {
+  const query = new URLSearchParams({ session, expectedSession: session })
+  return `${baseUrl}?${query.toString()}`
+}
+
+function captureHistoryTargets(page: Page): string[] {
+  const targets: string[] = []
+  page.on('request', (request) => {
+    const path = new URL(request.url()).pathname
+    if (path !== '/api/session.history' && path !== '/api/subagent.history') return
+    const envelope = request.postDataJSON() as {
+      payload?: { sessionId?: unknown; childSessionId?: unknown }
+    }
+    const target = path === '/api/session.history'
+      ? envelope.payload?.sessionId
+      : envelope.payload?.childSessionId
+    if (typeof target === 'string') targets.push(target)
+  })
+  return targets
+}
+
+function captureSessionMutationRequests(page: Page): string[] {
+  const methods: string[] = []
+  page.on('request', (request) => {
+    const path = new URL(request.url()).pathname
+    if (path === '/api/session.create' || path === '/api/session.fork') methods.push(path)
+  })
+  return methods
+}
+
+async function seedRootSession(scaffold: WebScaffold, id: string, prompt: string): Promise<void> {
+  const session = sessionId(id)
+  const createdAt = Date.now() - 60_000
+  await scaffold.ctx.sessionPersistence.create({
+    version: SESSION_FORMAT_VERSION,
+    id: session,
+    createdAt,
+    cwd: scaffold.workspaceCwd,
+    delegationDepth: 0,
+  })
+  await scaffold.ctx.sessionPersistence.append(session, [
+    {
+      type: 'turn/start', seq: 0, time: createdAt,
+      data: { turn: 1, trigger: { kind: 'message', source: { kind: 'user' } } },
+    },
+    {
+      type: 'user/message', seq: 1, time: createdAt + 1,
+      data: { content: [{ type: 'text', text: prompt }], source: { kind: 'user' } },
+      surfaceOp: 'append',
+    },
+    {
+      type: 'step/start', seq: 2, time: createdAt + 2,
+      data: { turn: 1, step: 1 },
+    },
+    {
+      type: 'assistant/message', seq: 3, time: createdAt + 3,
+      data: {
+        turn: 1,
+        step: 1,
+        message: {
+          id: '00000000-0000-4000-8000-000000000001',
+          role: 'assistant',
+          content: [{ type: 'text', text: 'Addressed root ready.' }],
+          source: { kind: 'model', provider: 'snapshot', model: 'snapshot-replier' },
+        },
+      },
+      sourceEventSeqs: [],
+      surfaceOp: 'append',
+    },
+    {
+      type: 'step/end', seq: 4, time: createdAt + 4,
+      data: { turn: 1, step: 1 },
+    },
+    {
+      type: 'session/title', seq: 5, time: createdAt + 5,
+      data: { title: prompt, messageSeqs: [1], source: { kind: 'fallback' } },
+    },
+    {
+      type: 'turn/end', seq: 6, time: createdAt + 6,
+      data: { turn: 1, reason: { kind: 'completed' } },
+    },
+  ] as SessionEvent[])
+  await scaffold.ctx.sessionProjectionCache.coldSnapshot(session)
+}
+
+describe('web e2e: addressed embedded Session boot', () => {
+  let scaffold: WebScaffold
+  let browser: Browser
+  let context: BrowserContext
+  let firstPage: Page
+  let secondPage: Page
+  let firstHistory: string[]
+  let secondHistory: string[]
+
+  beforeAll(async () => {
+    scaffold = await launchWebScaffold()
+    await seedRootSession(scaffold, FIRST_ROOT, 'Keep the first addressed root isolated.')
+    await seedRootSession(scaffold, SECOND_ROOT, 'Keep the second addressed root isolated.')
+    const childId = sessionId(SECOND_CHILD)
+    const createdAt = Date.now() - 30_000
+    await scaffold.ctx.sessionPersistence.create({
+      version: SESSION_FORMAT_VERSION,
+      id: childId,
+      createdAt,
+      cwd: scaffold.workspaceCwd,
+      parentSession: sessionId(SECOND_ROOT),
+      origin: 'subagent',
+      delegationDepth: 1,
+    })
+    await scaffold.ctx.sessionPersistence.append(childId, [
+      {
+        type: 'turn/start', seq: 0, time: createdAt,
+        data: { turn: 1, trigger: { kind: 'message', source: { kind: 'user' } } },
+      },
+      {
+        type: 'user/message', seq: 1, time: createdAt + 1,
+        data: {
+          content: [{ type: 'text', text: 'Inspect the addressed child.' }],
+          source: { kind: 'user' },
+        },
+        surfaceOp: 'append',
+      },
+      {
+        type: 'subagent/descriptor', seq: 2, time: createdAt + 2,
+        data: snapshotSubagentDescriptor({
+          mode: 'continuable', provider: 'spawn', label: SECOND_CHILD_LABEL,
+        }),
+      },
+      {
+        type: 'turn/end', seq: 3, time: createdAt + 3,
+        data: { turn: 1, reason: { kind: 'completed' } },
+      },
+    ] as SessionEvent[])
+    await scaffold.ctx.sessionProjectionCache.coldSnapshot(childId)
+    await expect(scaffold.ctx.subagents.listChildren(sessionId(SECOND_ROOT))).resolves.toMatchObject([
+      { kind: 'child', id: childId, mode: 'continuable', label: SECOND_CHILD_LABEL },
+    ])
+    browser = await chromium.launch()
+    context = await browser.newContext({ locale: 'en-US', viewport: { width: 1280, height: 900 } })
+    // Both pages see the same stale global cell. Addressed boot must not read
+    // or overwrite it; display labels are deliberately unrelated carrier data.
+    await context.addInitScript(() => {
+      localStorage.setItem('dsh.sessions.current', JSON.stringify({ sessionId: 'stale-global-root' }))
+    })
+    firstPage = await context.newPage()
+    secondPage = await context.newPage()
+    watchConsole(firstPage)
+    watchConsole(secondPage)
+    firstHistory = captureHistoryTargets(firstPage)
+    secondHistory = captureHistoryTargets(secondPage)
+    await Promise.all([
+      firstPage.goto(addressedUrl(scaffold.baseUrl, FIRST_ROOT, 'left'), { waitUntil: 'load' }),
+      secondPage.goto(addressedUrl(scaffold.baseUrl, SECOND_ROOT, 'right'), { waitUntil: 'load' }),
+    ])
+  }, 120_000)
+
+  afterAll(async () => {
+    const failures: unknown[] = []
+    await context?.close().catch((error: unknown) => failures.push(error))
+    await browser?.close().catch((error: unknown) => failures.push(error))
+    await scaffold?.close().catch((error: unknown) => failures.push(error))
+    if (failures.length === 1) throw failures[0]
+    if (failures.length > 1) throw new AggregateError(failures, 'addressed embedded teardown failed')
+  })
+
+  it('keeps two same-origin runtimes distinct across legal child navigation, return and refresh', async () => {
+    await Promise.all([
+      firstPage.locator('[data-embedded="true"]').waitFor({ timeout: 30_000 }),
+      secondPage.locator('[data-embedded="true"]').waitFor({ timeout: 30_000 }),
+    ])
+    expect(await firstPage.getByRole('tree', { name: 'Sessions' }).count()).toBe(0)
+    expect(await secondPage.getByRole('tree', { name: 'Sessions' }).count()).toBe(0)
+    await expect.poll(() => firstHistory.at(-1), { timeout: 30_000 }).toBe(FIRST_ROOT)
+    await expect.poll(() => secondHistory.at(-1), { timeout: 30_000 }).toBe(SECOND_ROOT)
+
+    const childCatalogTrigger = secondPage.getByRole('button', { name: '1 subagent' })
+    expect(
+      await childCatalogTrigger.count(),
+      await secondPage.locator('body').ariaSnapshot(),
+    ).toBe(1)
+    await childCatalogTrigger.focus()
+    await childCatalogTrigger.press('ArrowDown')
+    await secondPage.getByRole('treeitem', { name: new RegExp(SECOND_CHILD_LABEL) }).click()
+    await secondPage.getByText('Inspect the addressed child.', { exact: true }).waitFor({ timeout: 30_000 })
+    expect(secondHistory).toContain(SECOND_CHILD)
+    expect(firstHistory.at(-1)).toBe(FIRST_ROOT)
+
+    const hierarchy = secondPage.getByRole('navigation', { name: 'Session hierarchy' })
+    await hierarchy.getByRole('button').first().click()
+    await secondPage.locator('[data-conversation-scroll]')
+      .getByText('Keep the second addressed root isolated.', { exact: true })
+      .waitFor({ timeout: 30_000 })
+    expect(firstHistory.at(-1)).toBe(FIRST_ROOT)
+
+    const previousSecondHistory = secondHistory.length
+    await secondPage.reload({ waitUntil: 'load' })
+    await secondPage.locator('[data-embedded="true"]').waitFor({ timeout: 30_000 })
+    await expect.poll(() => secondHistory.length, { timeout: 30_000 }).toBeGreaterThan(previousSecondHistory)
+    expect(secondHistory.at(-1)).toBe(SECOND_ROOT)
+    expect(firstHistory.at(-1)).toBe(FIRST_ROOT)
+  })
+
+  it('fails closed before the Composer for invalid, mismatched and absent roots', async () => {
+    const invalid = await context.newPage()
+    const mismatch = await context.newPage()
+    const missing = await context.newPage()
+    try {
+      await invalid.goto(`${scaffold.baseUrl}?embedded=1`, { waitUntil: 'load' })
+      await invalid.getByText('embedded presentation requires session', { exact: false }).waitFor({ timeout: 30_000 })
+      expect(await invalid.locator('textarea').count()).toBe(0)
+
+      await mismatch.goto(
+        `${scaffold.baseUrl}?embedded=1&session=${FIRST_ROOT}&expectedSession=${SECOND_ROOT}`,
+        { waitUntil: 'load' },
+      )
+      await mismatch.getByText('session does not match expectedSession', { exact: false }).waitFor({ timeout: 30_000 })
+      expect(await mismatch.locator('textarea').count()).toBe(0)
+
+      await missing.goto(addressedUrl(scaffold.baseUrl, 'addressed-missing-root', 'ignored'), { waitUntil: 'load' })
+      await missing.locator('[data-addressed-session-gate="missing"]').waitFor({ timeout: 30_000 })
+      expect(await missing.locator('textarea').count()).toBe(0)
+    } finally {
+      await Promise.all([invalid.close(), mismatch.close(), missing.close()])
+    }
+  })
+
+  it('rejects a visible cross-root sidebar selection without changing the transcript or history target', async () => {
+    const page = await context.newPage()
+    const history = captureHistoryTargets(page)
+    try {
+      await page.goto(addressedGlobalUrl(scaffold.baseUrl, SECOND_ROOT), { waitUntil: 'load' })
+      const tree = page.getByRole('tree', { name: 'Sessions' })
+      await tree.waitFor({ timeout: 30_000 })
+      await expect.poll(() => history.at(-1), { timeout: 30_000 }).toBe(SECOND_ROOT)
+
+      const firstRow = tree.getByRole('treeitem').filter({ hasText: 'Keep the first addressed root isolated.' })
+      const secondRow = tree.getByRole('treeitem').filter({ hasText: 'Keep the second addressed root isolated.' })
+      const transcript = page.locator('[data-conversation-scroll]')
+      await transcript.getByText('Keep the second addressed root isolated.', { exact: true })
+        .waitFor({ timeout: 30_000 })
+      expect(await firstRow.getAttribute('aria-selected')).toBe('false')
+      expect(await secondRow.getAttribute('aria-selected')).toBe('true')
+      const historyBefore = [...history]
+
+      const rejection = page.waitForEvent('pageerror')
+      await firstRow.click()
+      expect(String(await rejection)).toContain(
+        `sessions.open: session ${FIRST_ROOT} is outside addressed root ${SECOND_ROOT}`,
+      )
+
+      expect(history).toEqual(historyBefore)
+      expect(await firstRow.getAttribute('aria-selected')).toBe('false')
+      expect(await secondRow.getAttribute('aria-selected')).toBe('true')
+      await transcript.getByText('Keep the second addressed root isolated.', { exact: true }).waitFor()
+      expect(await transcript.getByText('Keep the first addressed root isolated.', { exact: true }).count()).toBe(0)
+    } finally {
+      await page.close()
+    }
+  })
+
+  it('keeps fixed-root create and fork UI actions side-effect free in embedded and global presentations', async () => {
+    const embeddedMutations = captureSessionMutationRequests(secondPage)
+    const embeddedErrors: string[] = []
+    secondPage.on('pageerror', error => embeddedErrors.push(String(error)))
+    expect(await secondPage.getByRole('button', { name: 'Branch into a new conversation' }).count()).toBe(0)
+    expect(embeddedMutations).toEqual([])
+    expect(embeddedErrors).toEqual([])
+
+    const page = await context.newPage()
+    const mutations = captureSessionMutationRequests(page)
+    const pageErrors: string[] = []
+    page.on('pageerror', error => pageErrors.push(String(error)))
+    try {
+      await page.goto(addressedGlobalUrl(scaffold.baseUrl, SECOND_ROOT), { waitUntil: 'load' })
+      await page.getByRole('tree', { name: 'Sessions' }).waitFor({ timeout: 30_000 })
+      const newSessionButtons = page.getByRole('button', { name: 'New Session' })
+      expect(await newSessionButtons.count()).toBeGreaterThan(0)
+      for (let index = 0; index < await newSessionButtons.count(); index++) {
+        expect(await newSessionButtons.nth(index).isDisabled()).toBe(true)
+      }
+      expect(await page.getByRole('button', { name: 'Branch into a new conversation' }).count()).toBe(0)
+      await page.waitForTimeout(100)
+
+      expect(mutations).toEqual([])
+      expect(pageErrors).toEqual([])
+      await page.locator('[data-conversation-scroll]')
+        .getByText('Keep the second addressed root isolated.', { exact: true })
+        .waitFor({ timeout: 30_000 })
+    } finally {
+      await page.close()
+    }
+  })
+})
+
+describe('web e2e: blank addressed root is directly composable', () => {
+  let scaffold: WebScaffold
+  let browser: Browser
+  let context: BrowserContext
+  let page: Page
+
+  beforeAll(async () => {
+    scaffold = await launchWebScaffold({ replayFixture: BLANK_FIXTURE, paceMs: 1 })
+    await seedBlankSession(scaffold, BLANK_ROOT, scaffold.workspaceCwd)
+    browser = await chromium.launch()
+    context = await browser.newContext({ locale: 'en-US', viewport: { width: 1280, height: 900 } })
+    page = await context.newPage()
+    watchConsole(page)
+  }, 120_000)
+
+  afterAll(async () => {
+    const failures: unknown[] = []
+    await context?.close().catch((error: unknown) => failures.push(error))
+    await browser?.close().catch((error: unknown) => failures.push(error))
+    await scaffold?.close().catch((error: unknown) => failures.push(error))
+    if (failures.length === 1) throw failures[0]
+    if (failures.length > 1) throw new AggregateError(failures, 'blank addressed teardown failed')
+  })
+
+  it('does not offer Workspace mutation and sends through the fixed Session', async () => {
+    const mutations: string[] = []
+    page.on('request', (request) => {
+      const path = new URL(request.url()).pathname
+      if (
+        path === '/api/host.createDirectory'
+        || path === '/api/workspace.create'
+        || path === '/api/session.create'
+      ) mutations.push(path)
+    })
+
+    await page.goto(addressedUrl(scaffold.baseUrl, BLANK_ROOT, 'blank'), { waitUntil: 'load' })
+    await page.locator('[data-embedded="true"]').waitFor({ timeout: 30_000 })
+    expect(await page.getByRole('button', { name: 'Choose workspace' }).count()).toBe(0)
+
+    const composer = page.locator('textarea').first()
+    await composer.waitFor({ timeout: 30_000 })
+    expect(await composer.isEditable()).toBe(true)
+    const settled = scaffold.whenTurnSettled()
+    await composer.fill(BLANK_PROMPT)
+    await composer.press('Enter')
+    expect(await settled).toBe(sessionId(BLANK_ROOT))
+    await page.getByText('DONE', { exact: true }).waitFor({ timeout: 30_000 })
+    expect(mutations).toEqual([])
+  }, 120_000)
+})
